                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                            <MenuItem>
                                <MenuItem.Icon>
                                    <Image Source="Images/lake.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for lake
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyLakeSlowBridgeCommand}"  CommandParameter="LakeWood">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood bridge for lake
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyLakeFastBridgeCommand}"  CommandParameter="LakeModern">
                                        <MenuItem.Icon>
                                            <Image Source="Images/modernbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Modern bridge for lake
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/river.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for lake
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyRiverSlowBridgeCommand}"  CommandParameter="RiverWood">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>

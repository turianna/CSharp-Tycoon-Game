<Window x:Class="SpongeBobTycoonWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpongeBobTycoonWPF"
        mc:Ignorable="d"
        Title="SpongeBob_Tycoon" Height="450" Width="800"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Left">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="New Game" Command="{Binding NewGameCommand}" BorderBrush="Black"/>
            <MenuItem Header="Load" Command="{Binding LoadCommand}" BorderBrush="Black"/>
            <MenuItem Header="Save" BorderBrush="Black" Click="MenuItem_Click"/>
            <MenuItem Header="Quit" Command="{Binding QuitCommand}" BorderBrush="Black"/>
            <MenuItem Header="Info" Command="{Binding InfoCommand}" BorderBrush="Black"/>
        </Menu>


        <Popup Placement="Center" AllowsTransparency="True" 
           IsOpen="{Binding InfoIsOpen}" 
           StaysOpen="True">

            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" 
                CornerRadius="5" Padding="20" Width="300">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Build roads between industries and cities to deliver the materials produced by the industries to the city residents. Additionally, transport the city residents to other cities. You will receive money from the citizens for your help, make sure not to go bankrupt, otherwise the game ends." 
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Elements of the map" 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" FontWeight="Bold" FontSize="16" />

                        <TextBlock Text="City" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/varos.png" Stretch="Fill" Margin="0,0,0,0"/>

                        <TextBlock Text="Industry" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/gyar.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="In the top right corner of the factories, you can see what they produce. However, if you hover your mouse over them, it will also display exactly what kind of factory it is." 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Lava - River" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/lavakep.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="Lava - Lake" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/lavatokep.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="There are two types of lava: lava rivers and lava lakes. You can only cross them by building bridges. Watch out, though: you must buy specifically designed lake bridges for lakes, and river bridges for rivers." 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Forest" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/erdo.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="Trees grow continuously in the forests, and once enough have grown, they will start to spread. You can build roads on forest tiles, but it is more expensive. Don't worry, forests only spread to sand tiles." 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Sand" 
                            TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/magassag.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="The different colors indicate the height of the tiles. If you hover your mouse over them, you can see their exact height. The height only ranges from 0 to 4." 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="How to play" 
                            TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" FontWeight="Bold" FontSize="16" />

                        <TextBlock Text="Buy" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/vasarlas.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="Under this tab, you can buy various items. Hover your mouse over the icons to see how much they cost." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Road" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the road icon, then select a suitable tile: a sand tile next to an existing road. You can also build roads on forest tiles, but at a higher cost. Furthermore, roads can only be built between tiles with the same elevation or a maximum elevation difference of +-1." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Stop" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the stop icon and select a suitable tile: a road tile adjacent to a city or an industry." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Vehicle" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the vehicle icon, and it will bring up two options: a van and a truck. Vans can carry less item and are slower, while trucks can carry more item and are faster. After that, select what you want to transport. Your vehicle will be added to the parked vehicles list." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Bridge" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the bridge icon, then select whether you want it for a river or a lake. Next, choose whether to buy a wooden bridge, where vehicles travel slower, or a modern bridge, where they can travel faster." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Terraform" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/terraformalas.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="Under this tab, you can terraform. Hover your mouse over the icons to see how much they cost." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Up" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the up arrow icon to increase the elevation of the selected sand tiles. But be careful: the elevation difference between two tiles can be a maximum of 2." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Down" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the down arrow icon to decrease the elevation of the selected sand tiles. But be careful: the elevation difference between two tiles can be a maximum of 2." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Route manager" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="14" />
                        <Image Source="Images/megvettauto.png" Stretch="Fill" Margin="0,0,0,0"/>
                        <TextBlock Text="Under this tab, you can create routes and remove vehicles from them." 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Create route" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the parked vehicles list. Here you can see the vehicles you have purchased that haven't been placed on the map and aren't transporting items yet. Select a vehicle, then choose the stops you want it to visit. Once you have selected them, click the 'Create Route' button in the top right corner. " 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <Image Source="Images/stoplerakas.png" Stretch="Fill" Margin="0,0,0,5"/>
                        <Image Source="Images/utvegleg.png" Stretch="Fill" Margin="0,0,0,5"/>
                        <TextBlock Text="Creating a valid route" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Creating a valid route: based on the chosen vehicle's cargo, you must select the stops so that the vehicle visits all the required raw material industries, then the production industry, and finally a city. " 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Valid routes" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="City -> City" 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Wood -> City" 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Net -> City" 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Algae -> Petfood -> City" 
                                TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />
                        <TextBlock Text="Meat -> Spatula -> Burger -> City" 
                                 TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <TextBlock Text="Remove vehicle from route" 
                                TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,15" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Click the moving vehicles list. Here you can see the vehicles you have purchased that have been placed on the map and are transporting items yet. Select a vehicle that you want to remove."
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"  FontSize="12" />

                        <Button Content="OK" Width="80" Command="{Binding CloseInfoCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>


        <Menu Grid.Row="0" HorizontalAlignment="Center" Height="30">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem>
                <MenuItem.Icon>
                    <Image Source="Images/buy.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Buy
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Command="{Binding BuyRoadCommand}" Margin="0,2,2,2" >
                        <MenuItem.Icon>
                            <Image Source="Images/road.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    <ToolTip Content="{Binding RoadPrice}" ContentStringFormat="Road - {0} Dollars" />
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding PutStopCommand}" Margin="2,2,2,2">
                        <MenuItem.Icon>
                            <Image Source="Images/stop.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Stop
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Margin="2,2,2,2">
                        <MenuItem.Icon>
                            <Image Source="Images/buy_vehicle.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Vehicle types
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <Menu Margin="-45,0,-60,0" HorizontalAlignment="Center">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/truck.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            <ToolTip Content="{Binding TruckPrice}" ContentStringFormat="Truck - {0} Dollars" />
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyTruckCommand}" CommandParameter="Wood" Margin="0,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/wood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyTruckCommand}" CommandParameter="Petfood" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/petfood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Petfood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyTruckCommand}"  CommandParameter="Burger" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/burger.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Burger
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyTruckCommand}"  CommandParameter="Net" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/net.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Net
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyTruckCommand}"  CommandParameter="Citizen" Margin="2,2,0,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/citizen.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Citizen
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>

                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/van.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            <ToolTip Content="{Binding VanPrice}" ContentStringFormat="Van - {0} Dollars" />
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyVanCommand}" CommandParameter="Wood" Margin="0,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/wood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyVanCommand}"  CommandParameter="Petfood" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/petfood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Petfood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem  Command="{Binding BuyVanCommand}"  CommandParameter="Burger" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/burger.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Burger
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem  Command="{Binding BuyVanCommand}"  CommandParameter="Net" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/net.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Net
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyVanCommand}"  CommandParameter="Citizen" Margin="2,2,0,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/citizen.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Citizen
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                        </Menu>
                    </MenuItem>
                    <MenuItem Margin="2,2,0,2">
                        <MenuItem.Icon>
                            <Image Source="Images/bridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Buy bridge
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                            <MenuItem>
                                <MenuItem.Icon>
                                    <Image Source="Images/lake.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for lake
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyLakeSlowBridgeCommand}"  CommandParameter="LakeWood">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>

                                                    <ToolTip Content="{Binding WoodBridgeLakePrice}" ContentStringFormat="Wood bridge for lake - {0} Dollars" />
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyLakeFastBridgeCommand}"  CommandParameter="LakeModern">
                                        <MenuItem.Icon>
                                            <Image Source="Images/modernbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>

                                                    <ToolTip Content="{Binding ModernBridgeLakePrice}" ContentStringFormat="Modern bridge for lake - {0} Dollars" />
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/river.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for river
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyRiverSlowBridgeCommand}"  CommandParameter="RiverWood">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>

                                                    <ToolTip Content="{Binding WoodBridgeRiverPrice}" ContentStringFormat="Wood bridge for river - {0} Dollars" />
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyRiverFastBridgeCommand}"  CommandParameter="RiverModern">
                                        <MenuItem.Icon>
                                            <Image Source="Images/modernbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>

                                                    <ToolTip Content="{Binding ModernBridgeRiverPrice}" ContentStringFormat="Modern bridge for river - {0} Dollars" />
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                        </Menu>
                    </MenuItem>
                </Menu>
            </MenuItem>
            <MenuItem >
                <MenuItem.Icon>
                    <Image Source="Images/terraform.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Terraformation
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Command="{Binding TerraformUpCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/up-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>

                                    <ToolTip Content="{Binding TerraformPrice}" ContentStringFormat="Upward terraformation - {0} Dollars" />
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding TerraformDownCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/down-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>

                                    <ToolTip Content="{Binding TerraformPrice}" ContentStringFormat="Downward terrafarmation - {0} Dollars" />
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </Menu>
            </MenuItem>

            <MenuItem>
                <MenuItem.Icon>
                    <Image Source="Images/route.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Create route
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/movingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars on the map
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding MovingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button  Command="{Binding ClickCommand}" CommandParameter="{Binding Vehicle}">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Vehicle type: {0}, Product: {1}">
                                                    <Binding Path="VehicleType"/>
                                                    <Binding Path="Product" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/parkingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars in the garage
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding ParkingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ClickCommand}" CommandParameter="{Binding Vehicle}" >
                                        <TextBlock>
                                            <TextBlock.Text>

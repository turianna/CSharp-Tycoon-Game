<Window x:Class="SpongeBobTycoonWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpongeBobTycoonWPF"
        mc:Ignorable="d"
        Title="SpongeBob_Tycoon" Height="450" Width="800"
        WindowState="Maximized"
       ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Left">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="New Game" Command="{Binding NewGameCommand}" BorderBrush="Black"/>
            <MenuItem Header="Load" Command="{Binding LoadCommand}" BorderBrush="Black"/>
            <MenuItem Header="Save" Command="{Binding SaveCommand}" BorderBrush="Black"/>
            <MenuItem Header="Quit" Command="{Binding QuitCommand}" BorderBrush="Black"/>
        </Menu>

        <Menu Grid.Row="0" HorizontalAlignment="Center" Height="30">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem>
                <MenuItem.Icon>
                    <Image Source="Images/buy.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Buy
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Command="{Binding BuyRoadCommand}" Margin="0,2,2,2" >
                        <MenuItem.Icon>
                            <Image Source="Images/road.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Road
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding PutStopCommand}" Margin="2,2,2,2">
                        <MenuItem.Icon>
                            <Image Source="Images/stop.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Stop
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Margin="2,2,2,2">
                        <MenuItem.Icon>
                            <Image Source="Images/buy_vehicle.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Vehicle types
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <Menu Margin="-45,0,-60,0" HorizontalAlignment="Center">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/truck.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Truck
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyWoodTruckCommand}" Margin="0,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/wood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyPetfoodTruckCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/petfood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Petfood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyBurgerTruckCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/burger.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Burger
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyNetTruckCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/net.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Net
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyCitizenTruckCommand}" Margin="2,2,0,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/citizen.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Citizen
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>

                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/van.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Van
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-35,0,-50,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyWoodVanCommand}" Margin="0,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/wood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyPetfoodVanCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/petfood.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Petfood
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem  Command="{Binding BuyBurgerVanCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/burger.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Burger
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem  Command="{Binding BuyNetVanCommand}" Margin="2,2,2,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/net.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Net
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyCitizenVanCommand}" Margin="2,2,0,2">
                                        <MenuItem.Icon>
                                            <Image Source="Images/citizen.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Citizen
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                        </Menu>
                    </MenuItem>
                    <MenuItem Command="{Binding BuyBridgeCommand}" Margin="2,2,0,2">
                        <MenuItem.Icon>
                            <Image Source="Images/bridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Buy bridge
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>
                            <MenuItem>
                                <MenuItem.Icon>
                                    <Image Source="Images/lake.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for lake
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyLakeWoodBridgeCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood bridge for lake
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyLakeModernBridgeCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="Images/modernbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Modern bridge for lake
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                            <MenuItem >
                                <MenuItem.Icon>
                                    <Image Source="Images/river.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                        <Image.ToolTip>
                                            Bridges for lake
                                        </Image.ToolTip>
                                    </Image>
                                </MenuItem.Icon>
                                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                                    <Menu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </Menu.ItemsPanel>
                                    <MenuItem Command="{Binding BuyRiverWoodBridgeCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="Images/woodbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Wood bridge for river
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding BuyRiverModernBridgeCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="Images/modernbridge.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                                <Image.ToolTip>
                                                    Modern bridge for river
                                                </Image.ToolTip>
                                            </Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </Menu>
                            </MenuItem>
                        </Menu>
                    </MenuItem>
                </Menu>
            </MenuItem>
            <MenuItem >
                <MenuItem.Icon>
                    <Image Source="Images/terraform.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Terraformation
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Command="{Binding TerraformUpCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/up-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Upward terraformation
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding TerraformDownCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/down-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Downward terrafarmation
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </Menu>
            </MenuItem>

            <MenuItem>
                <MenuItem.Icon>
                    <Image Source="Images/route.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Create route
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/movingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars on the map
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding MovingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding MovingVehicleListSize}" Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="Moving Car"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/parkingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars in the garage
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding ParkingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding ParkingCarVehicleSize}" Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="Parking Car"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>
                </Menu>
            </MenuItem>
        </Menu>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Board}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="50" Columns="100"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Content}" Command="{Binding ClickCommand}" CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Color}" Value="0">
                                        <Setter Property="Background" Value="Blue" />
                                        <Setter Property="BorderBrush" Value="Blue" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="1">
                                        <Setter Property="Background" Value="Green" />
                                        <Setter Property="BorderBrush" Value="Green" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="2">
                                        <Setter Property="Background" Value="Red" />
                                        <Setter Property="BorderBrush" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="3">
                                        <Setter Property="Background" Value="Yellow" />
                                        <Setter Property="BorderBrush" Value="Yellow" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="4">
                                        <Setter Property="Background" Value="Gray" />
                                        <Setter Property="BorderBrush" Value="Gray" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="5">
                                        <Setter Property="Background" Value="LightBlue" />
                                        <Setter Property="BorderBrush" Value="LightBlue" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Color}" Value="6">
                                        <Setter Property="Background" Value="PaleGreen" />
                                        <Setter Property="BorderBrush" Value="PaleGreen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StatusBar Grid.Row="2" HorizontalAlignment="Left">
            <StatusBarItem>
                <Button Width="60" Command="{Binding StopTimeCommand}">
                    <Viewbox>
                        <TextBlock Text="Stop time" />
                    </Viewbox>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button Height="20" Command="{Binding StartTimeCommand}">
                    <Viewbox>
                        <TextBlock Text="Start time" />
                    </Viewbox>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button Height="20" Command="{Binding SpeedUpTimeCommand}">
                    <Viewbox>
                        <TextBlock Text="Speed up time" />
                    </Viewbox>
                </Button>
            </StatusBarItem>
        </StatusBar>

        <StatusBar Grid.Row="2" HorizontalAlignment="Right">
            <TextBlock Text="Time:" FontWeight="Bold" Height="20"/>
            <TextBlock Text="{Binding GameTime}" Margin="10, 0, 10, 0"/>
            <TextBlock Text="Dollars:" FontWeight="Bold" Height="20"/>
            <TextBlock Text="{Binding Money}" Margin="10, 0, 10, 0"/>
        </StatusBar>
    </Grid>
</Window>

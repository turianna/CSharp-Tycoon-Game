                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem Command="{Binding TerraformUpCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/up-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Upward terraformation
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding TerraformDownCommand}">
                        <MenuItem.Icon>
                            <Image Source="Images/down-arrow.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Downward terrafarmation
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </Menu>
            </MenuItem>

            <MenuItem>
                <MenuItem.Icon>
                    <Image Source="Images/route.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                        <Image.ToolTip>
                            Create route
                        </Image.ToolTip>
                    </Image>
                </MenuItem.Icon>
                <Menu Margin="-55,0,-70,0" HorizontalAlignment="Center">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/movingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars on the map
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding MovingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button  Command="{Binding ClickCommand}" CommandParameter="{Binding Vehicle}">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Vehicle type: {0}, Product: {1}">
                                                    <Binding Path="VehicleType"/>
                                                    <Binding Path="Product" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>
                    <MenuItem>
                        <MenuItem.Icon>
                            <Image Source="Images/parkingcar.png" Width="40" Height="20" Margin="-5,-10,-10,-10">
                                <Image.ToolTip>
                                    Cars in the garage
                                </Image.ToolTip>
                            </Image>
                        </MenuItem.Icon>
                        <ItemsControl ItemsSource="{Binding ParkingVehicleList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding ClickCommand}" CommandParameter="{Binding Vehicle}" >
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Vehicle type: {0}, Product: {1}">
                                                    <Binding Path="VehicleType"/>
                                                    <Binding Path="Product" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>
                </Menu>
            </MenuItem>
        </Menu>

        <Menu Grid.Row="0" HorizontalAlignment="Right">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <Button Content="Create Route" Command="{Binding CreateRouteCommand}" BorderBrush="Black">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Route_IsOn}" Value="true">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Route_IsOn}" Value="false">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Menu>
        

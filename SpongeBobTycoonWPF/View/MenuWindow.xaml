<Window x:Class="SpongeBobTycoonWPF.View.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpongeBobTycoonWPF.View"
        mc:Ignorable="d"
        Title="MenuWindow" Height="450" Width="800"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/background.jpg" 
                Stretch="UniformToFill" 
                Opacity="0.8"/>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="START GAME" Width="150" Height="40" Margin="5" Background="White" Command="{Binding StartCommand}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
            <Button Content="LOAD GAME" Width="150" Height="40" Margin="5" Background="White" Command="{Binding LoadCommand}"/>
            <Button Content="QUIT" Width="150" Height="40" Margin="5" Background="White" Command="{Binding QuitCommand}"/>
        </StackPanel>
    </Grid>
</Window>

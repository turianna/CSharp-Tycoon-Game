<Window x:Class="SpongeBobTycoonWPF.GameLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpongeBobTycoonWPF"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="GameLoadWindow" Height="600" Width="450">
    <StackPanel>
        <TextBlock Text="Choose a saved game!" TextWrapping="Wrap" TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding SaveFiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" Background="LightGray">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding FileName}" Grid.Column="0"
                                   Margin="5,5,15,5" FontWeight="Bold"/>

                        <TextBlock Text="Time:" Grid.Column="1" Margin="5"/>
                        <TextBlock Text="{Binding GameTime}" Grid.Column="1" Margin="40,5,5,5"/>

                        <TextBlock Text="Money: $" Grid.Column="2" Margin="5"/>
                        <TextBlock Text="{Binding Money}" Grid.Column="2" Margin="55,5,5,5"/>
                        <Button Content="Load game!" Grid.Column="3" Margin="30, 0, 5, 0"
                                Command="{Binding LoadGame}" 
                                CommandParameter="{Binding FileName}">
                        </Button>

                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            Content="Close" Width="100" Foreground="Black"  Background="DeepSkyBlue" Click="Button_Click"/>
    </StackPanel>
</Window>

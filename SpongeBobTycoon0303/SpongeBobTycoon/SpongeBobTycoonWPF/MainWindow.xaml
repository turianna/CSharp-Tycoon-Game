        <StatusBar Grid.Row="2" HorizontalAlignment="Left">
            <StatusBarItem>
                <Button Height="25" Command="{Binding StopTimeCommand}">
                    <Image Source="Images/pause.png" Width="40" Height="20"  HorizontalAlignment="Center">
                        <Image.ToolTip>
                            Pause game
                        </Image.ToolTip>
                    </Image>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button Height="25" Command="{Binding StartTimeCommand}">
                    <Image Source="Images/play.png" Width="40" Height="20"  HorizontalAlignment="Center">
                        <Image.ToolTip>
                            Start game
                        </Image.ToolTip>
                    </Image>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button Height="25" Command="{Binding SpeedUpTimeCommand}">
                    <Image Source="Images/fast-forward.png" Width="40" Height="20" HorizontalAlignment="Center">
                        <Image.ToolTip>
                            Speed up
                        </Image.ToolTip>
                    </Image>
                </Button>
            </StatusBarItem>
        </StatusBar>

        <StatusBar Grid.Row="2" HorizontalAlignment="Right">
            <TextBlock Text="Time:" FontWeight="Bold" Height="20"/>
            <TextBlock Text="{Binding GameTime}" Margin="10, 0, 10, 0"/>
            <TextBlock Text="Dollars:" FontWeight="Bold" Height="20"/>
            <TextBlock Text="{Binding Money}" Margin="10, 0, 10, 0"/>
        </StatusBar>
    </Grid>
